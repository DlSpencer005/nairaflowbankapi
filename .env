# Paystack API Configuration
# Copy this file .env and add your actual keys
# Never commit .env file version control

# Paystack Secret Key (for server-side API calls)
VITE_PAYSTACK_SECRET_KEY=sk_test_97f69ecb7c3d8774f12ba5fac10e53cac1d3ff1b

# Paystack Public Key (for client-side API calls)
